# Secure operations profile (subprocess helper, token auth, no committed secrets).
# Export a unique token before starting:
#   export MANTICORE_AUTH_TOKEN="$(openssl rand -hex 16)"
#   export MANTICORE_AUTH_TOKEN_ISSUED_AT="$(date +%s)"
#   export MANTICORE_AUTH_TOKEN_TTL_SECS=86400
#   cargo run --release -- --profile secure
MANTICORE_PROFILE=secure
MANTICORE_PRIVILEGED=true
MANTICORE_HELPER_MODE=subprocess
MANTICORE_AUTH_MODE=token
MANTICORE_ROLE=operator
MANTICORE_AUTH_TOKEN_TTL_SECS=86400
MANTICORE_AUTH_TOKEN_GRACE_SECS=30
MANTICORE_SNAPSHOT_HISTORY_ENABLED=false
