# Optional stack profile for Docker / mixed local runs
MANTICORE_PROFILE=stack
MANTICORE_PRIVILEGED=false
MANTICORE_HELPER_MODE=embedded
MANTICORE_AUTH_MODE=local
MANTICORE_ROLE=viewer
MANTICORE_REFRESH_MS=1000
MANTICORE_STORE_ENABLED=true
MANTICORE_SEARCH_ENABLED=true
MANTICORE_OBS_HTTP_ENABLED=true
MANTICORE_OBS_HTTP_PORT=9463
MANTICORE_EVENT_STREAM_ENABLED=true
MANTICORE_EVENT_STREAM_PORT=9462
MANTICORE_PEERWEAVE_ENABLED=true
MANTICORE_PEERWEAVE_GRAPHQL_URL=http://localhost:3200/graphql
MANTICORE_PEERWEAVE_PUBLISH_ENABLED=true
MANTICORE_PEERWEAVE_PUBLISH_SPACE_ID=sentinel-space
MANTICORE_EVRUS_ENABLED=true
MANTICORE_EVRUS_OIDC_URL=http://localhost:8790
MANTICORE_LOG_JSON=true
