# Ecosystem-connected operations profile.
# Supply secrets via the environment or a gitignored *.local.env overlay.
# Do not put CapTokens, JWTs, or RPC passwords in this file.
MANTICORE_PROFILE=ecosystem
MANTICORE_PRIVILEGED=true
MANTICORE_HELPER_MODE=subprocess
MANTICORE_AUTH_MODE=evrus
MANTICORE_ROLE=admin

# PeerWeave connector
MANTICORE_PEERWEAVE_ENABLED=true
MANTICORE_PEERWEAVE_GRAPHQL_URL=http://127.0.0.1:3200/graphql
MANTICORE_PEERWEAVE_POLL_MS=5000
MANTICORE_PEERWEAVE_PUBLISH_ENABLED=false
MANTICORE_PEERWEAVE_PUBLISH_SPACE_ID=
MANTICORE_PEERWEAVE_PUBLISH_MS=5000

# EVRUS connector + identity bridge
MANTICORE_EVRUS_ENABLED=true
MANTICORE_EVRUS_OIDC_URL=http://127.0.0.1:8790

# Evrmore audit anchoring (requires RPC URL + credentials in the environment)
MANTICORE_EVRUS_ANCHOR_ENABLED=true
MANTICORE_EVRUS_ANCHOR_INTERVAL_SECS=300
MANTICORE_EVRUS_RPC_URL=http://127.0.0.1:8819

# Audit log retention (rotation + optional archiving).
MANTICORE_AUDIT_MAX_ENTRIES=10000
MANTICORE_AUDIT_ARCHIVE_ENABLED=true

# Local historical snapshot persistence (JSONL under .beads/state).
MANTICORE_SNAPSHOT_HISTORY_ENABLED=true
MANTICORE_SNAPSHOT_HISTORY_MAX_ENTRIES=1000
MANTICORE_SNAPSHOT_HISTORY_MAX_AGE_SECS=
MANTICORE_SNAPSHOT_HISTORY_MAX_BYTES=
MANTICORE_SNAPSHOT_HISTORY_SLIM_RECORDS=false
MANTICORE_SNAPSHOT_HISTORY_RESET_ON_START=false

# Optional alert policy scaffold (JSON string or path to JSON file).
MANTICORE_ALERT_POLICY_JSON=
MANTICORE_ALERT_POLICY_PATH=
