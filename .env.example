# Copy to .env for Docker Compose overrides. Never commit .env.
# Host ports stay on 127.0.0.1 via docker-compose.yml.

# MANTICORE_REFRESH_MS=1000
# RUST_LOG=info

# Optional connector tokens (empty = lab stubs accept unauthenticated GraphQL)
# MANTICORE_PEERWEAVE_CAP_TOKEN=
# MANTICORE_PEERWEAVE_GRAPHQL_URL=http://peerweave:3200/graphql
# MANTICORE_PEERWEAVE_PUBLISH_SPACE_ID=sentinel-space
# MANTICORE_EVRUS_OIDC_URL=http://evrus-oidc:8790
# OIDC_ISSUER_URL=http://evrus-oidc:8790
